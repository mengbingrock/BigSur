{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "customConditions": [
      "react-native-legacy-deep-imports",
      "react-native"
    ]
  },
  "include": [
    "app",
    "src",
    "test"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
